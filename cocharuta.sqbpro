e_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="58"/><column index="3" value="42"/><column index="4" value="47"/><column index="5" value="143"/><column index="6" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="routes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="47"/><column index="2" value="79"/><column index="3" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE IF NOT EXISTS train_schedules (
    id INTEGER PRIMARY KEY,
    route_id TEXT NOT NULL REFERENCES routes(id),
    day_type TEXT NOT NULL CHECK (day_type IN ('semana', 'sabado', 'domingo')),
    first_departure TEXT NOT NULL CHECK (first_departure GLOB '[0-2][0-9]:[0-5][0-9]'),
    last_departure TEXT NOT NULL CHECK (last_departure GLOB '[0-2][0-9]:[0-5][0-9]'),
    headway_min INTEGER NOT NULL CHECK (headway_min BETWEEN 1 AND 240),
    UNIQUE (route_id, day_type)
);

INSERT OR REPLACE INTO train_schedules (route_id, day_type, first_departure, last_departure, headway_min) VALUES
    ('Verde', 'semana',  '06:00', '21:00', 30),
    ('Verde', 'sabado',  '06:00', '21:00', 30),
    ('Verde', 'domingo', '06:00', '21:00', 30);</sql><current_tab id="0"/></tab_sql></sqlb_project>
